# 复制为 .env 后修改（deploy.sh 首次运行会自动复制，并提示设置密码）
# compose 项目名固定，数据卷名为 netdisk_netdisk_data
COMPOSE_PROJECT_NAME=netdisk
# 宿主机端口
PORT=8686
# 登录密码（必填，至少 6 位）。修改后重新部署，所有已登录设备会被强制下线
NETDISK_PASSWORD=
# 网盘总容量（GB）
NETDISK_QUOTA_GB=2
# 同时在线设备数上限
NETDISK_MAX_DEVICES=10
# 设备多少天不活动后自动下线
NETDISK_SESSION_DAYS=30
# 同一 IP 连续输错密码几次后锁定，锁定多少分钟
NETDISK_LOGIN_MAX_FAILS=5
NETDISK_LOGIN_LOCK_MINUTES=10
# 上 HTTPS（Nginx/Caddy 反代）后改为 1
NETDISK_COOKIE_SECURE=0
# 前面有反代时填写反代的来源 IP（宿主机 Nginx 访问容器时一般是 Docker 网关 172.17.0.1 或
# 自定义网络网关），这样设备列表和登录锁定才能拿到真实客户端 IP。不确定可填 *（仅在端口不对外暴露时）
FORWARDED_ALLOW_IPS=127.0.0.1
# pip 镜像源（构建镜像时下载依赖），选离服务器最近的：
#   腾讯云公网  https://mirrors.cloud.tencent.com/pypi/simple
#   腾讯云内网  http://mirrors.tencentyun.com/pypi/simple（需同时设置 PIP_TRUSTED_HOST=mirrors.tencentyun.com）
#   阿里云内网  http://mirrors.cloud.aliyuncs.com/pypi/simple（PIP_TRUSTED_HOST=mirrors.cloud.aliyuncs.com）
#   阿里云公网  https://mirrors.aliyun.com/pypi/simple
#   清华        https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
PIP_TRUSTED_HOST=
