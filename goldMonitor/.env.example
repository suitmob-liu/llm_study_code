# 复制为 .env 后按需修改（deploy.sh 首次运行会自动复制）
# compose 项目名固定，数据卷名为 goldmonitor_gold_data
COMPOSE_PROJECT_NAME=goldmonitor
PORT=1012
# 行情刷新间隔（分钟）
REFRESH_MINUTES=5
# 自动预测间隔（小时），0 关闭自动预测
PREDICT_INTERVAL_HOURS=5
# 设置后，网页上的预测/训练/修改情景等写操作需要口令
ADMIN_TOKEN=
# pip 镜像源（构建镜像时下载依赖），选离服务器最近的：
#   腾讯云公网  https://mirrors.cloud.tencent.com/pypi/simple
#   腾讯云内网  http://mirrors.tencentyun.com/pypi/simple   （仅腾讯云服务器可用，最快；需同时设置 PIP_TRUSTED_HOST=mirrors.tencentyun.com）
#   阿里云内网  http://mirrors.cloud.aliyuncs.com/pypi/simple（仅阿里云 ECS 可用；PIP_TRUSTED_HOST=mirrors.cloud.aliyuncs.com）
#   阿里云公网  https://mirrors.aliyun.com/pypi/simple
#   清华        https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
PIP_TRUSTED_HOST=
# 服务器无法直连 Yahoo Finance 时配置代理
HTTP_PROXY=
HTTPS_PROXY=
