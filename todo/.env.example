# ============================================================
# 待办·墨记 — 环境变量配置
# 使用方法：复制本文件为 .env，填入实际值
#   cp .env.example .env
# ============================================================

# 会话加密密钥（留空则自动生成，生产环境建议固定）
TODO_SECRET_KEY=

# ============================================================
# 微信推送配置（以下四种任选其一，也可不配置）
# 注意：这是全局 fallback，每个用户也可在页面上单独配置自己的 token
# ============================================================

# 方式1: WxPusher（推荐，完全免费，2000条/天）
# 获取方式：
#   1. 访问 wxpusher.zjiecode.com → 微信扫码登录 → 「应用管理」→ 新建应用 → 复制 appToken
#   2. 关注公众号「wxpusher」→ 点击「我的」→「我的UID」→ 复制 UID
# 示例: WXPUSHER_APPTOKEN=AT_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 示例: WXPUSHER_UID=UID_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WXPUSHER_APPTOKEN=
WXPUSHER_UID=

# 方式2: PushPlus（免费版有限额）
# 获取方式：微信关注公众号「pushplus」→ 登录 pushplus.plus → 首页复制 token
# 示例: PUSHPLUS_TOKEN=e359982a7e954ba5b04e8a5f694798dc
PUSHPLUS_TOKEN=

# 方式3: Server酱（免费版 5条/天）
# 获取方式：用 GitHub 登录 sct.ftqq.com → 微信扫码绑定 → 复制 SendKey
# 示例: SERVERCHAN_KEY=SCT1234567890abcdefghijklmnopqrstuvwxyz
SERVERCHAN_KEY=

# 方式4: 企业微信 Webhook（仅推送到企业微信群，非个人微信）
# 获取方式：企业微信群 → 设置 → 群机器人 → 添加 → 复制 Webhook 地址
# 示例: WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WECHAT_WEBHOOK_URL=
